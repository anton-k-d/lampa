# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS web
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=secret,id=proxy_ca,required=false if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; npm ci
COPY . .
RUN npm run build:web

FROM node:24-bookworm-slim AS runtime
WORKDIR /app/server
COPY server/package.json server/package-lock.json ./
RUN --mount=type=secret,id=proxy_ca,required=false if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; npm ci --omit=dev
COPY server/src ./src
COPY server/admin ./admin
COPY schemas /app/schemas
COPY --from=web /app/build/github/lampa /app/build/github/lampa
EXPOSE 8080
CMD ["node", "src/main.mjs"]
