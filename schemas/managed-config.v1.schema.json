{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lampa:managed-config:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "values"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "enum": [
        "global",
        "device"
      ]
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "values": {
      "$ref": "#/$defs/values"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "device"
          }
        }
      },
      "then": {
        "required": [
          "deviceId"
        ]
      },
      "else": {
        "not": {
          "required": [
            "deviceId"
          ]
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https?://[^\\s]+$"
    },
    "secretRef": {
      "type": "string",
      "pattern": "^secret:[a-zA-Z0-9_-]{1,128}$"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "mode"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/url"
        },
        "mode": {
          "enum": [
            "gateway",
            "direct-device"
          ]
        },
        "credentialRef": {
          "$ref": "#/$defs/secretRef"
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "enabled",
        "sha256",
        "permissions",
        "minClientVersion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "enabled": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "minClientVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "maxLength": 32
        },
        "permissions": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "metadata",
              "playback",
              "network",
              "storage"
            ]
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "endpoint"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "$ref": "#/$defs/endpoint"
        }
      }
    },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "providerId": {
              "$ref": "#/$defs/id"
            },
            "endpoint": {
              "$ref": "#/$defs/endpoint"
            },
            "locale": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
              "maxLength": 35
            },
            "region": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "onlyReleased": {
              "type": "boolean"
            }
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "defaultSourceId": {
          "$ref": "#/$defs/id"
        },
        "plugins": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/plugin"
          }
        },
        "torrServer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "primary": {
              "$ref": "#/$defs/endpoint"
            },
            "backup": {
              "$ref": "#/$defs/endpoint"
            },
            "saveToDatabase": {
              "type": "boolean"
            },
            "preload": {
              "type": "boolean"
            }
          }
        },
        "parser": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "kind": {
              "enum": [
                "jackett",
                "torznab",
                "custom"
              ]
            },
            "endpoint": {
              "$ref": "#/$defs/endpoint"
            }
          }
        },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "theme": {
              "enum": [
                "system",
                "dark",
                "light"
              ],
              "default": "system"
            },
            "density": {
              "enum": [
                "comfortable",
                "compact"
              ],
              "default": "comfortable"
            },
            "animations": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "search": {
              "type": "boolean"
            },
            "sync": {
              "type": "boolean"
            },
            "plugins": {
              "type": "boolean"
            }
          }
        },
        "lockedPaths": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "enum": [
              "/metadata/providerId",
              "/metadata/endpoint",
              "/metadata/locale",
              "/sources",
              "/defaultSourceId",
              "/plugins",
              "/torrServer",
              "/parser",
              "/features",
              "/ui",
              "/ui/theme",
              "/ui/density",
              "/ui/animations"
            ]
          }
        }
      }
    }
  }
}
