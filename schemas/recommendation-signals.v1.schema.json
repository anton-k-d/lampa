{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recommendation device snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "seq", "digest", "records"],
  "properties": {
    "schemaVersion": {"const": 1},
    "seq": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "records": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "signals", "rank", "lastActivityAt"],
        "properties": {
          "key": {"type": "string", "pattern": "^tmdb:(movie|tv):[1-9][0-9]{0,11}$"},
          "signals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["liked", "bookmarked", "planned", "history", "started", "completed", "abandoned"]}},
          "rank": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 9007199254740991}, {"type": "null"}]},
          "lastActivityAt": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
        }
      }
    }
  }
}
